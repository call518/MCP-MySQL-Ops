# OpenWebUI global default model params (JSON), applied to every model.
# Some OpenAI reasoning models reject MCP tool calls on /v1/chat/completions
# unless reasoning_effort is "none", failing with:
#   "Function tools with reasoning_effort are not supported ..."
# Seeded into the OpenWebUI database on first startup only. If the
# open-webui-data volume already exists, set it in the Admin UI instead.
# Models or providers that do not support reasoning_effort may reject it;
# if so, comment this out and set Reasoning Effort per model instead.
DEFAULT_MODEL_PARAMS={"reasoning_effort":"none"}

# Generate a unique value with: openssl rand -hex 32
WEBUI_SECRET_KEY=replace_with_a_random_value

# Copy the tracked template to this ignored local file before starting MCPO.
MCPO_CONFIG_FILE=mcp-config.json.http.local

# Commons
PYTHONPATH=/app/src

# MCP Server Configuration
# Transport 설정 : streamable-http 모드
FASTMCP_TYPE=streamable-http
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8000

# =============================================================================
# Remote Authentication Settings (for streamable-http mode)
# =============================================================================
# Enable Bearer token authentication for streamable-http transport
# Default: false (if not defined or empty, defaults to false)
# Values: true/false, 1/0, yes/no, on/off (case insensitive)
# WARNING: If REMOTE_AUTH_ENABLE=false, the server will accept requests without authentication!
REMOTE_AUTH_ENABLE=false
# Secret key for Bearer token authentication (required when REMOTE_AUTH_ENABLE=true)
# Default: empty string (if not defined, authentication will be disabled even if REMOTE_AUTH_ENABLE=true)
# Recommendation: Use strong, randomly generated secret keys (32+ characters)
REMOTE_SECRET_KEY=

# 로깅 레벨 설정
MCP_LOG_LEVEL=INFO

### MySQL Configuration
MYSQL_VERSION=8
MYSQL_MAX_CONNECTIONS=200

#### MySQL Root Configuration for Docker:
MYSQL_ROOT_HOST=%
MYSQL_ROOT_PASSWORD=changeme

#### MySQL Host Configuration:
MYSQL_HOST=host.docker.internal
MYSQL_PORT=13306
MYSQL_USER=root
MYSQL_PASSWORD=${MYSQL_ROOT_PASSWORD}
MYSQL_DATABASE=test_ecommerce
# Note: MYSQL_DATABASE serves as the default target database for operations
# when no specific database is specified. Test data will create additional databases:
# test_ecommerce, test_analytics, test_inventory, test_hr
#--------------------------------------------

# Docker Env.
DOCKER_BIND_ADDRESS=127.0.0.1
DOCKER_EXTERNAL_PORT_OPENWEBUI=3004
DOCKER_EXTERNAL_PORT_MCP_SERVER=18004
DOCKER_EXTERNAL_PORT_MCPO_PROXY=8004
